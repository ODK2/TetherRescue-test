<!-- 1단계 바다 씬 (뼈대)
     좌표: x=-25(해안 쪽) ~ +25(먼바다), y=-25 ~ +25, 정지 수면 z=0
     hfield 높이 = data(0~1) * elevation + geom pos z
       water  : data 0.5 가 정지 수면. 아래 elevation/pos 는 기본값일 뿐이고,
                실행 시 WaterSurface 가 파도 최대 높이에 맞춰 덮어쓴다 (±R, R = Σ진폭 × 1.05)
       seabed : World(ocean=cfg) 가 Bathymetry 로 높이 범위·위치·데이터를 채운다
                (z ∈ [-deep_depth, +beach_height], 컴파일 전 MjSpec 으로 범위 설정)
     hfield data는 런타임에 Python에서 채운다 (sim/water_surface.py, ocean/bathymetry.py).
     size(x,y) 와 water nrow/ncol 은 World(ocean=cfg) 가 config/ocean.yaml 값으로 덮어쓴다 (MjSpec). -->
<mujoco model="ocean">
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.15 0.15 0.15" specular="0 0 0"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.55 0.75 0.95" rgb2="0.95 0.97 1" width="256" height="256"/>
    <material name="water" rgba="0.10 0.36 0.60 0.75" specular="0.8" shininess="0.9" reflectance="0.1"/>
    <material name="seabed" rgba="0.80 0.72 0.52 1"/>

    <hfield name="water"  nrow="128" ncol="128" size="25 25 1.0 0.01"/>
    <hfield name="seabed" nrow="128" ncol="128" size="25 25 6.0 0.5"/>
  </asset>

  <worldbody>
    <!-- 낮은 각도의 햇빛: 파도 경사면에 명암이 생겨야 높이 변화가 눈에 보인다 -->
    <light name="sun" pos="0 0 30" dir="-0.6 0.35 -0.7" directional="true" diffuse="0.8 0.8 0.8" specular="0.4 0.4 0.4"/>
    <geom name="seabed" type="hfield" hfield="seabed" pos="0 0 -6.0" material="seabed"/>
    <!-- 수면은 시각 전용: 충돌 없음. group=1 → 광선(ray) 검사에서 해저와 구분 -->
    <geom name="water" type="hfield" hfield="water" pos="0 0 -0.5" material="water"
          contype="0" conaffinity="0" group="1"/>
  </worldbody>
</mujoco>
